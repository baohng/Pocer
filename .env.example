# Copy to .env and fill in. .env is gitignored.

# --- Client (bundled into the public JS -- never put a secret here) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server only (used by api/insight.ts; deliberately no VITE_ prefix, so
#     these stay out of the client bundle) ---
# Leave DEEPSEEK_API_KEY empty to run the insight endpoint in mock mode: it
# returns a summary built from your real numbers without calling any API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
